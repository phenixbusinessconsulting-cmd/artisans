# Mot de passe de la base PostgreSQL dédiée (conteneur db). Généré au premier déploiement.
POSTGRES_PASSWORD=

# Enrichissement téléphone / site / spécialités (Google Places API New, payante)
GOOGLE_PLACES_API_KEY=

# Département ciblé par l'import
DEPARTEMENT=91

# Mode administrateur (bouton « contacté », commentaires) : 12 caractères minimum, lettres et chiffres.
# En production, il vient du secret GitHub ADMIN_PASSWORD.
ADMIN_PASSWORD=
