# Supabase (auto-hébergé sur le VPS : utiliser host.docker.internal depuis les conteneurs)
SUPABASE_URL=http://host.docker.internal:8000
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Enrichissement téléphone / site / spécialités (Google Places API New, payante)
GOOGLE_PLACES_API_KEY=

# Département ciblé par l'import
DEPARTEMENT=91
